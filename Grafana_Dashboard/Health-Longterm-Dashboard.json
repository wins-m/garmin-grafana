      "datasource": {
        "type": "influxdb",
        "uid": "garmin_influxdb"
      },
      "targets": [
        {
          "refId": "H",
          "datasource": {
            "type": "influxdb",
            "uid": "garmin_influxdb"
          },
          "rawQuery": true,
          "resultFormat": "table",
          "query": "SELECT \"LatitudeGCJ\" AS \"latitude\", \"LongitudeGCJ\" AS \"longitude\", \"TrackPointIndex\", \"CoordinateSystem\", \"CoordinateSystemSource\", \"SatelliteTimeKnown\" FROM \"HuaweiActivityTrack\" WHERE \"Source\" = 'huawei' AND \"MapEligible\" = 'true' AND \"ActivitySelector\"::tag =~ /^${ActivityGPS:regex}$/ AND $timeFilter ORDER BY time ASC"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "view": {
          "id": "fit",
          "allLayers": true,
          "padding": 5,
