                },
                "opacity": 0.85,
                "size": {
                  "fixed": 3
                },
                "lineWidth": 2
              },
              "arrow": 0
            }
          },
          {
            "type": "markers",
            "name": "华为轨迹点",
            "filterData": {
              "id": "byRefId",
              "options": "H"
            },
            "tooltip": true,
            "location": {
              "mode": "coords",
              "latitude": "latitude",
              "longitude": "longitude"
            },
            "config": {
              "showLegend": false,
              "style": {
                "color": {
                  "fixed": "#d55181"
                },
                "opacity": 0.85,
                "size": {
                  "fixed": 3
                },
                "symbol": {
                  "mode": "fixed",
                  "fixed": "img/icons/marker/circle.svg"
                }
              }
            }
          }
        ]
      },
      "transformations": [
        {
          "id": "sortBy",
          "filter": {
            "id": "byRefId",
            "options": "H"
          },
          "options": {
            "sort": [
              {
                "field": "TrackPointIndex",
                "desc": false
              }
            ]
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "exclude": {
              "names": [
                "Time",
                "time"
              ]
            }
          }
        }
      ],
      "description": "华为轨迹按 TrackPointIndex 排序；存储时间仅为活动开始时间加序号，已从地图移除，不能解释为每点采样时间。SatelliteTimeKnown=false 表示原始卫星时间未知；本地图不推算时间、速度或心率。CoordinateSystemSource=raw_unconfirmed 表示未确认的原始坐标回退，位置可能有偏移；export_default 为导出约定，explicit 为记录明确声明，legacy 为旧记录。华为只有至少两个有效点且 MapEligible=true 的活动可选。 高德底图使用 LatitudeGCJ/LongitudeGCJ。"
    },
