          "showScale": true,
          "showAttribution": true
        },
        "basemap": {
          "type": "xyz",
          "name": "高德",
          "config": {
            "url": "https://webrd01.is.autonavi.com/appmaptile?lang=zh_cn&size=1&scale=1&style=8&x={x}&y={y}&z={z}",
            "attribution": "© 高德地图"
          }
        },
        "layers": [
          {
            "type": "route",
            "name": "华为轨迹",
            "filterData": {
              "id": "byRefId",
              "options": "H"
            },
            "tooltip": false,
            "location": {
              "mode": "coords",
              "latitude": "latitude",
              "longitude": "longitude"
            },
            "config": {
