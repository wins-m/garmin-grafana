    {
      "id": 11,
      "type": "table",
      "title": "跑步记录",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 17
      },
      "datasource": {
        "type": "influxdb",
        "uid": "garmin_influxdb"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "garmin_influxdb"
          },
          "rawQuery": true,
          "resultFormat": "table",
          "query": "SELECT \"activityName\" AS \"名称\", \"distance\" / 1000 AS \"距离\", \"elapsedDuration\" AS \"用时\", \"elapsedDuration\" / (\"distance\" / 1000) AS \"配速\", \"elevationGain\" AS \"爬升\", \"averageHR\" AS \"平均心率\" FROM \"ActivitySummary\" WHERE \"activityType\" =~ /running/ AND $timeFilter GROUP BY \"Device\""
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "Time": "开始",
              "Device": "设备"
            },
            "indexByName": {
              "Time": 0,
              "名称": 1,
              "距离": 2,
              "用时": 3,
              "配速": 4,
              "爬升": 5,
              "平均心率": 6,
              "Device": 7
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "开始",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "距离"
            },
            "properties": [
              {
                "id": "unit",
                "value": "lengthkm"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "用时"
            },
            "properties": [
              {
                "id": "unit",
                "value": "clocks"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "配速"
            },
            "properties": [
              {
                "id": "unit",
                "value": "clocks"
              },
              {
